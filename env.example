# Copy to .env. Every VITE_ value is public: it ships to every visitor's browser.
# Never put WooCommerce consumer keys, passwords or tokens here. The build refuses to run if you do.

# Public WooCommerce Store API (no keys needed)
VITE_STORE_API_URL=https://nardshop.com/wp-json/wc/store/v1

# Drop countdown (Thursday, October 22, 2026 at 3:00 PM ET)
VITE_DROP_DATE=2026-10-29T15:00:00-04:00

# Optional: where text signups are sent (defaults to FormSubmit email)
# VITE_WAITLIST_URL=
# VITE_SMS_NUMBER=

# Find the card prize (server only, no VITE_ prefix, never shipped to the browser)
# GAME_SECRET signs each dealt round. Use a long random string.
# NARD_COUPON_CODE is the WooCommerce coupon handed out after a verified 3-round win.
# GAME_SECRET=
# NARD_COUPON_CODE=

# Klaviyo (public site ID only, never a private pk_ key)
# Settings > Account > API keys > Public API Key / Site ID
# Lists & segments > the list ID in the URL
# VITE_KLAVIYO_COMPANY_ID=
# VITE_KLAVIYO_LIST_ID=
# Email campaigns. Falls back to VITE_KLAVIYO_LIST_ID when this is empty.
# VITE_KLAVIYO_EMAIL_LIST_ID=
